# Copy to .env.local and fill in. Only the NEXT_PUBLIC_ values reach the browser.

# --- Supabase (Project Settings -> API) -----------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# The publishable (or legacy anon) key. Safe in the browser: Row Level
# Security is the boundary. Never put the service_role key in this app.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of this deployment, no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Scheduled jobs (server only) ------------------------------------------
# Random 64-character hex strings. CRON_SECRET authenticates Vercel Cron to
# /api/cron/*. APP_SERVER_SECRET lets those routes call privileged database
# functions; its SHA-256 must be stored in private.app_config
# (key: server_secret_sha256). See README, "Rotating the server secret".
CRON_SECRET=
APP_SERVER_SECRET=

# Web Push. Generate a pair with: npx web-push generate-vapid-keys
# The public key is sent to browsers; the private key is a secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URL sent to push services: your site's https address, or mailto:you@example.com
VAPID_SUBJECT=

# --- Instagram import (optional until the account is authorised) -----------
# A long-lived Meta access token. It can also be pasted in Admin -> Instagram,
# which stores it in the database and refreshes it automatically.
INSTAGRAM_ACCESS_TOKEN=
# Only for the Facebook Login flavour of the API (Page-linked account).
INSTAGRAM_USER_ID=
# INSTAGRAM_API_VERSION=v23.0

# --- Email digests (optional until a sender domain is verified) ------------
RESEND_API_KEY=
# e.g. BMSCE Alumni Network <digest@your-verified-domain>
NEWSLETTER_FROM=

# --- scripts/verify.mjs (local testing only, never real people) ------------
# TEST_ADMIN_EMAIL=      TEST_ADMIN_PASSWORD=
# TEST_ALUM_EMAIL=       TEST_ALUM_PASSWORD=
# TEST_STUDENT_EMAIL=    TEST_STUDENT_PASSWORD=
