# Copy this file to .env.local and fill in the three values below.
#   cp .env.local.example .env.local
#
# Where to find them: Supabase dashboard -> your project ->
# Project Settings -> API
#
# Only these three are needed. Nothing here is secret beyond the anon key,
# which is safe to expose to the browser (RLS policies do the protecting).
# Never put the service_role key in this file — the app does not use it.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / "public" API key (the long JWT, or the new sb_publishable_... key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of this app. Keep as-is for local dev; set to your real domain
# in production so auth redirect links point to the right place.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
